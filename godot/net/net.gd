extends Node
## Autoload `Net` (M8): the multiplayer lobby and the in-battle lockstep driver.
##
## Lobby (NETCODE §7), host-authoritative, JSON on channel 0 after byte 16:
##   client -> host  hello {name, sim, data, protocol}       set {nation, team, color}
##   host -> client  welcome {slot} | refused {why}           lobby {players, map, money, seed}
##   host -> all     start {config} (the MatchConfig)          go {}
##   client -> host  ready {hash} (the MatchConfig hash it computed)
## Chat is a Chat message on channel 2. The host refuses peers whose sim version or dataHash
## (compiled TGI data, so mods) differ, and starts only when every peer reports the same
## MatchConfig hash. The match seed is generated by the host.
##
## In battle, `step(bridge)` replaces SimBridge.step(): it sends this machine's commands through
## the lockstep and runs the next tick once its bundle is in. AI slots are played on the host.

signal lobby_changed
signal chat_received(player: int, text: String)
signal match_starting(config: Dictionary)
signal failed(why: String)

const PROTOCOL := 1
const NATIONS := ["gbr", "ger", "usa", "rus", "jpn"]
const COLORS := ["blue", "red", "green", "yellow"]
const PING_MS := 500
const ADAPT_MS := 2000
const WAIT_MS := 3000
const DROP_MS := 60000

var tr: EnetTransport
var session: NetSession
var active := false            # a networked battle is running
var in_lobby := false
var is_host := false
var slot := -1
var my_name := "Player"
var sim_version := ""
var data_hash := ""
var players: Array = []        # [{slot, name, nation, team, color, ai ("" = human)}]
var map_spec := ""
var money := 0
var seed := 0
var config := {}
var status_text := ""
var waiting_text := ""         # "Waiting for <player>..." while stalled (battle HUD)
var desync_tick := -1
var _ready_hashes := {}
var _rtt := {}
var _jitter := {}
var _ping_id := 0
var _last_ping := 0
var _last_adapt := 0
var _bridge: SimBridge


# ---------------------------------------------------------------- lobby

## The sim version and data hash this machine would play with (loads the data once).
func identify(bridge: SimBridge, game_dir: String) -> bool:
	if data_hash != "":
		return true
	if not bridge.start(game_dir, "gen:1:64", 1):
		status_text = "cannot load the game data: " + bridge.last_error()
		return false
	sim_version = bridge.sim_version()
	data_hash = str(bridge.data_hash())
	return true


func host_lobby(port: int, name: String) -> Error:
	_reset()
	tr = EnetTransport.new()
	var err := tr.host(port, 7)
	if err != OK:
		status_text = "cannot listen on port %d" % port
		return err
	is_host = true
	in_lobby = true
	slot = 0
	my_name = name
	seed = randi() % 999999 + 1
	players = [{"slot": 0, "name": name, "nation": "gbr", "team": 0, "color": 0, "ai": ""},
		{"slot": 1, "name": "Dummy AI", "nation": "ger", "team": 1, "color": 1, "ai": "dummy"}]
	status_text = "Hosting on port %d" % port
	lobby_changed.emit()
	return OK


func join_lobby(address: String, port: int, name: String) -> Error:
	_reset()
	tr = EnetTransport.new()
	var err := tr.join(address, port)
	if err != OK:
		status_text = "cannot connect to %s:%d" % [address, port]
		return err
	is_host = false
	in_lobby = true
	my_name = name
	status_text = "Connecting to %s:%d..." % [address, port]
	lobby_changed.emit()
	return OK


func leave() -> void:
	if tr != null:
		tr.close()
	_reset()
	lobby_changed.emit()


func _reset() -> void:
	tr = null
	session = null
	active = false
	in_lobby = false
	is_host = false
	slot = -1
	players = []
	config = {}
	_ready_hashes = {}
	desync_tick = -1
	waiting_text = ""


## Host: change a slot (nation, team, color, ai: "" human / "dummy" / "slice" / "open").
func host_set(s: int, key: String, value: Variant) -> void:
	if not is_host:
		return
	for p in players:
		if int(p.slot) == s:
			p[key] = value
	_broadcast_lobby()


func host_add_ai() -> void:
	# The battle starts two kingdoms today (battle.gd _start_bases); net_match.tscn takes up to 8.
	if not is_host or players.size() >= 2:
		return
	var s := _free_slot()
	players.append({"slot": s, "name": "Dummy AI", "nation": NATIONS[s % NATIONS.size()], "team": s % 2, "color": s % COLORS.size(), "ai": "dummy"})
	_broadcast_lobby()


func host_remove(s: int) -> void:
	if not is_host or s == 0:
		return
	players = players.filter(func(p: Dictionary) -> bool: return int(p.slot) != s)
	if tr.slot_peers.has(s):
		tr.send_lobby(tr.slot_peers[s], {"t": "refused", "why": "removed by the host"})
		(tr.slot_peers[s] as ENetPacketPeer).peer_disconnect_later()
		tr.slot_peers.erase(s)
	_broadcast_lobby()


func host_settings(spec: String, start_money: int) -> void:
	map_spec = spec
	money = start_money
	_broadcast_lobby()


## A client asks the host to change its own slot.
func request_set(key: String, value: Variant) -> void:
	if is_host:
		host_set(slot, key, value)
	elif tr != null:
		tr.send_lobby(null, {"t": "set", key: value})


func send_chat(text: String) -> void:
	if tr == null or text.strip_edges() == "":
		return
	var msg := NetSession.encode_chat(slot, text)
	if is_host:
		tr.broadcast(EnetTransport.CH_CHAT, msg)
		chat_received.emit(slot, text)
	else:
		tr.send_to_host(EnetTransport.CH_CHAT, msg)


## Host: freeze the MatchConfig and ask everyone to confirm its hash.
func host_start() -> void:
	if not is_host:
		return
	for p in players:
		if str(p.ai) == "open":
			status_text = "slot %d is still open" % int(p.slot)
			lobby_changed.emit()
			return
	config = {"map": map_spec, "money": money, "seed": seed, "players": players.duplicate(true), "protocol": PROTOCOL,
		"sim": sim_version, "data": data_hash, "delay": 3}
	_ready_hashes = {0: config_hash(config)}
	tr.broadcast_lobby({"t": "start", "config": config})
	status_text = "Waiting for every player to confirm the match..."
	_maybe_go()


## The MatchConfig hash every peer must agree on. JSON turns ints into floats on the way, so
## integral numbers are canonicalized first.
static func config_hash(c: Dictionary) -> String:
	return JSON.stringify(_canon(c), "", true).sha256_text()


static func _canon(v: Variant) -> Variant:
	if v is Dictionary:
		var d := {}
		for k in v:
			d[str(k)] = _canon(v[k])
		return d
	if v is Array:
		return (v as Array).map(_canon)
	if v is float and v == floorf(v) and absf(v) < 9.0e15:
		return int(v)
	return v


func _free_slot() -> int:
	var used := {}
	for p in players:
		used[int(p.slot)] = true
	for s in 8:
		if not used.has(s):
			return s
	return -1


func _broadcast_lobby() -> void:
	if is_host and tr != null:
		tr.broadcast_lobby({"t": "lobby", "players": players, "map": map_spec, "money": money, "seed": seed})
	lobby_changed.emit()


func _maybe_go() -> void:
	for p in players:
		if str(p.ai) == "" and not _ready_hashes.has(int(p.slot)):
			return
	tr.broadcast_lobby({"t": "go"})
	_go()


func _go() -> void:
	in_lobby = false
	match_starting.emit(config)


func _on_lobby(from: int, peer: ENetPacketPeer, m: Dictionary) -> void:
	var t := str(m.get("t", ""))
	if is_host:
		match t:
			"hello":
				if int(m.get("protocol", 0)) != PROTOCOL or str(m.get("sim", "")) != sim_version or str(m.get("data", "")) != data_hash:
					tr.send_lobby(peer, {"t": "refused", "why": "different game version or game data (mods): sim %s / %s, data %s / %s" % [
						m.get("sim", "?"), sim_version, m.get("data", "?"), data_hash]})
					peer.peer_disconnect_later()
					return
				var s := -1
				for p in players:  # an AI or open slot is taken over by the newcomer
					if str(p.ai) == "open" or (str(p.ai) == "dummy" and s < 0):
						s = int(p.slot)
				if s < 0:
					s = _free_slot()
					if s < 0:
						tr.send_lobby(peer, {"t": "refused", "why": "the match is full"})
						return
					players.append({"slot": s, "name": "", "nation": NATIONS[s % NATIONS.size()], "team": s % 2, "color": s % COLORS.size(), "ai": ""})
				for p in players:
					if int(p.slot) == s:
						p.name = str(m.get("name", "Player"))
						p.ai = ""
				tr.bind_slot(peer, s)
				tr.send_lobby(peer, {"t": "welcome", "slot": s})
				_broadcast_lobby()
			"set":
				for k in ["nation", "team", "color"]:
					if m.has(k):
						host_set(from, k, m[k])
			"ready":
				if config.is_empty():
					return
				if str(m.get("hash", "")) != config_hash(config):
					status_text = "slot %d computed another MatchConfig hash" % from
					lobby_changed.emit()
					return
				_ready_hashes[from] = true
				_maybe_go()
	else:
		match t:
			"welcome":
				slot = int(m.slot)
				status_text = "Joined as slot %d" % slot
				lobby_changed.emit()
			"refused":
				status_text = "Refused: " + str(m.get("why", ""))
				failed.emit(status_text)
				leave()
			"lobby":
				players = m.players
				map_spec = str(m.map)
				money = int(m.money)
				seed = int(m.seed)
				lobby_changed.emit()
			"start":
				config = m.config
				tr.send_lobby(null, {"t": "ready", "hash": config_hash(config)})
				status_text = "Starting..."
				lobby_changed.emit()
			"go":
				_go()


# ---------------------------------------------------------------- the battle

## Called by the battle after tick 0 (which every machine steps locally from the config).
func begin_battle(bridge: SimBridge) -> void:
	_bridge = bridge
	session = NetSession.new()
	var mask := 0
	var local := 1 << slot
	for p in config.players:
		mask |= 1 << int(p.slot)
		if is_host and str(p.ai) != "":
			local |= 1 << int(p.slot)
			bridge.set_controller(int(p.slot), str(p.ai), str(p.nation))
	if is_host:
		session.start_host(mask, local, slot, int(config.delay))
	else:
		session.start_client(slot, int(config.delay))
	active = true
	_test_args()
	if _test.has("net-scripted"):  # two-instance tests: the dummy AI plays this machine's slot
		bridge.set_controller(slot, "dummy", str(slot_nations()[slot]))
	print("NET battle started: slot %d of %d, D=%d" % [slot, config.players.size(), int(config.delay)])


var _test := {}


func _test_args() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--net-"):
			var kv := a.trim_prefix("--").split("=", true, 1)
			_test[kv[0]] = kv[1] if kv.size() > 1 else ""


## `--net-quit-at=N`: print the hash at tick N, save LastFilm and quit (two-instance tests).
func _check_test_end(bridge: SimBridge) -> void:
	if not _test.has("net-quit-at") or bridge.tick() < int(_test["net-quit-at"]):
		return
	print("NET BATTLE OK slot %d tick %d hash %s" % [slot, bridge.tick(), bridge.state_hash()])
	save_last_film(bridge)
	active = false
	tr.flush()
	await get_tree().create_timer(1.0).timeout
	leave()
	get_tree().quit(0)


## Films (NETCODE §8): every match is recorded to user://LastFilm.rpl, with keyframes.
func save_last_film(bridge: SimBridge) -> Dictionary:
	var names := PackedStringArray()
	for p in config.get("players", []):
		names.append("%s (%s)" % [str(p.name), str(p.nation)])
	var r: Dictionary = bridge.save_film(ProjectSettings.globalize_path("user://LastFilm.rpl"), names)
	print("NET LastFilm: %s" % ("%d ticks, %d keyframes, %d bytes" % [int(r.ticks), int(r.keyframes), int(r.get("bytes", 0))] if r.ok else str(r.error)))
	return r


## Nation per slot (index = player id) and team per slot, from the MatchConfig.
func slot_nations() -> Array:
	var out := []
	for p in config.get("players", []):
		while out.size() <= int(p.slot):
			out.append("gbr")
		out[int(p.slot)] = str(p.nation)
	while out.size() < 2:
		out.append("ger")
	return out


func slot_teams() -> PackedInt32Array:
	var out := PackedInt32Array()
	for p in config.get("players", []):
		while out.size() <= int(p.slot):
			out.append(out.size())
		out[int(p.slot)] = int(p.team)
	return out


func player_name(s: int) -> String:
	for p in config.get("players", players):
		if int(p.slot) == s:
			return str(p.name)
	return "player %d" % s


## One lockstep tick: false when its bundle hasn't arrived (the battle waits).
func step(bridge: SimBridge) -> bool:
	if not active or session == null:
		return false  # the match is over (or never started): nothing runs locally
	_pump()
	if not session.can_step():
		return false
	session.issue(bridge.take_commands())
	_flush_outgoing()
	bridge.step_commands(session.take_tick())
	var report: PackedByteArray = session.report_hash(bridge.tick() - 1, bridge.state_hash_bits())
	if not report.is_empty():
		tr.send_to_host(EnetTransport.CH_LOCKSTEP, report)
	var st: Dictionary = session.status(Time.get_ticks_msec())
	if int(st.get("desync_tick", -1)) >= 0 and desync_tick < 0:
		desync_tick = int(st.desync_tick)
		_dump_desync(bridge)
	_check_test_end(bridge)
	return true


## Bundles waiting to run (more than 2: run catch-up ticks).
func queued() -> int:
	return int(session.status(0).get("queued", 0)) if session != null else 0


func speed_percent() -> int:
	return int(session.status(0).get("speed", 100)) if session != null else 100


func is_paused() -> bool:
	return bool(session.status(0).get("paused", false)) if session != null else false


## Host: game speed and pause for everyone (a control in the next bundle).
func host_set_speed(percent: int) -> void:
	if is_host and session != null:
		session.set_speed(percent)


func host_set_paused(p: bool) -> void:
	if is_host and session != null:
		session.set_paused(p)


func _process(_delta: float) -> void:
	if tr == null:
		return
	_pump()
	if active and is_host:
		_host_housekeeping()


func _pump() -> void:
	if tr == null:
		return
	var now := Time.get_ticks_msec()
	for ev in tr.poll():
		match str(ev.type):
			"connect":
				if not is_host:
					tr.send_lobby(null, {"t": "hello", "name": my_name, "sim": sim_version, "data": data_hash, "protocol": PROTOCOL})
			"disconnect":
				if is_host:
					if in_lobby and int(ev.slot) >= 0:
						host_remove(int(ev.slot))
				else:
					status_text = "Disconnected from the host"
					if active:
						waiting_text = "The host left the game."
					failed.emit(status_text)
			"message":
				var data: PackedByteArray = ev.data
				var lobby := EnetTransport.lobby_message(data)
				if not lobby.is_empty():
					_on_lobby(int(ev.slot), ev.peer, lobby)
					continue
				if session == null:
					var r0: Dictionary = NetSession.new().receive(data, int(ev.slot), now)
					if str(r0.kind) == "chat":
						_on_chat(r0, int(ev.slot))
					continue
				var r: Dictionary = session.receive(data, int(ev.slot), now)
				match str(r.kind):
					"ping":
						tr.send(ev.peer, EnetTransport.CH_PING, r.reply)
					"pong":
						var rtt := now - int(r.sent_ms)
						var s := int(ev.slot)
						if _rtt.has(s):
							_jitter[s] = int(0.75 * float(_jitter.get(s, 0)) + 0.25 * absf(rtt - int(_rtt[s])))
						_rtt[s] = rtt
					"chat":
						_on_chat(r, int(ev.slot))
	if active:
		_flush_outgoing()
	tr.flush()


func _on_chat(r: Dictionary, from: int) -> void:
	var who := int(r.player)
	if is_host:
		who = from  # a client speaks for its own slot only
		tr.broadcast(EnetTransport.CH_CHAT, NetSession.encode_chat(who, str(r.text)))
	chat_received.emit(who, str(r.text))


func _flush_outgoing() -> void:
	if is_host:
		for b in session.host_poll(Time.get_ticks_msec()):
			tr.broadcast(EnetTransport.CH_LOCKSTEP, b)
	else:
		for p in session.outgoing():
			tr.send_to_host(EnetTransport.CH_LOCKSTEP, p)


func _host_housekeeping() -> void:
	var now := Time.get_ticks_msec()
	if now - _last_ping >= PING_MS:
		_last_ping = now
		_ping_id += 1
		tr.broadcast(EnetTransport.CH_PING, NetSession.encode_ping(_ping_id, now))
	var st: Dictionary = session.status(now)
	if now - _last_adapt >= ADAPT_MS and not _rtt.is_empty():
		_last_adapt = now
		var max_rtt := 0
		var max_jit := 0
		for s in _rtt:
			max_rtt = maxi(max_rtt, int(_rtt[s]))
			max_jit = maxi(max_jit, int(_jitter.get(s, 0)))
		var d := NetSession.adaptive_delay(max_rtt, max_jit)
		if d != int(st.input_delay):
			session.set_input_delay(d)
	var stalled := int(st.get("stalled_ms", 0))
	var names: Array[String] = []
	for s in st.get("waiting_on", []):
		if int(s) != slot:
			names.append(player_name(int(s)))
	waiting_text = ("Waiting for %s..." % ", ".join(names)) if stalled >= WAIT_MS and not names.is_empty() else ""
	if stalled >= DROP_MS:
		for s in st.get("waiting_on", []):
			if int(s) != slot:
				drop_to_ai(int(s))


## Host: a player who stopped answering is dropped and the dummy AI plays their kingdom.
func drop_to_ai(s: int) -> void:
	if not is_host or session == null:
		return
	var nation := "gbr"
	for p in config.players:
		if int(p.slot) == s:
			nation = str(p.nation)
	session.drop_player(s, true)
	if _bridge != null:
		_bridge.set_controller(s, "dummy", nation)  # the AIController interface: the real AI plugs in here
	chat_received.emit(-1, "%s was dropped; the AI takes over their kingdom." % player_name(s))


func _dump_desync(bridge: SimBridge) -> void:
	var path := "user://desync_%d_%d.state" % [slot, desync_tick]
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f != null:
		f.store_buffer(bridge.save_state())
		f.close()
	bridge.save_replay(ProjectSettings.globalize_path("user://desync_%d.rpl" % slot))
	waiting_text = "Desync at tick %d: the game has ended (state written to %s)." % [desync_tick, ProjectSettings.globalize_path(path)]
